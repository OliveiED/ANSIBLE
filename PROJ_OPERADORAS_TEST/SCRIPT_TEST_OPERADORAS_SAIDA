  "bb.com.br" "caixa.gov.br" "itau.com.br" "bradesco.com.br" "santander.com.br"
  "sicredi.com.br" "bancopan.com.br" "banrisul.com.br" "mercadopago.com.br" "nubank.com.br"
  "pagseguro.com.br" "binance.com"
  "gov.br" "receita.fazenda.gov.br" "servicos.efazenda.ms.gov.br" "web.detran.ms.gov.br"
  "planalto.gov.br" "camara.leg.br" "senado.leg.br" "stf.jus.br" "stj.jus.br" "tse.jus.br"
  "voip1.freewaynet.com.br" "skype.com" "zoom.us" "discord.com" "telegram.org"
  "mercadolivre.com.br" "americanas.com.br" "magazineluiza.com.br" "shopee.com.br" "aliexpress.com"
