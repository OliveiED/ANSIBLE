#!/bin/bash
# test_ping_zabbix_parallel_full_all_dests.sh
# ICMP + TCP em paralelo, envio para Zabbix
# Evandro 2025-10-03

BASE_DIR="/home/admin/my-setup-ansible/dash-servicos-operadoras/ping-results"
mkdir -p "$BASE_DIR"
ZABBIX_LOG="$BASE_DIR/zabbix_sender_results.txt"

ZABBIX_SERVER="172.16.30.113"
ZABBIX_HOST="MONITORAMENTO-SERVICOS-OPERADORAS"

# Fontes: ip_friendlyname
SOURCES=(
  "177.105.240.154_fibraplus"
  "177.105.240.155_linkbrasil"
#  "177.105.240.156_flextel"
#  "177.105.240.157_solucao"
)

# Destinos completos
DESTS=(
  "google.com" "youtube.com" "netflix.com" "amazon.com" "microsoft.com" "openai.com"
  "cloudflare.com" "facebook.com" "twitter.com" "apple.com" "linkedin.com" "whatsapp.com"
